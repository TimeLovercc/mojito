# Mojito agent. Every variable is required: the agent exits naming any that are missing or empty.
# Layout A (docs/SETUP.md): copy to /var/lib/mojito/agent.env, owner root, mode 600.
# Layout B: keep it outside the repo, e.g. ~/.config/mojito/secrets/agent.env.

# The hub, on the same machine
MOJITO_HUB_URL=http://127.0.0.1:8787
# The `agent` token from the hub's token file
MOJITO_AGENT_TOKEN=
# Output of `claude setup-token`; only passed on to `claude -p`. Treat it like a password.
CLAUDE_CODE_OAUTH_TOKEN=
# Absolute path of the claude executable of the user the agent runs as
MOJITO_CLAUDE_BIN=/var/lib/mojito/.local/bin/claude
# Google Calendar write grant (hub/deploy/google-auth.py --scope calendar). The file may be absent:
# the agent then runs without calendar writes, and System shows the grant as not connected.
MOJITO_GOOGLE_OAUTH=/var/lib/mojito/google-oauth.json
# Same IANA timezone as the hub
MOJITO_TIMEZONE=America/Los_Angeles

# uv: must match the environment used by `uv sync` for the agent
UV_PROJECT_ENVIRONMENT=/var/lib/mojito/agent-venv
UV_PYTHON_INSTALL_DIR=/var/lib/mojito/python
UV_CACHE_DIR=/var/lib/mojito/uv-cache
