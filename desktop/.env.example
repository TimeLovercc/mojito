# Copy to desktop/.env (ignored by git). npm run dev / build / build:dev / release load it.

# your IANA timezone, the same as mobile's EXPO_PUBLIC_MOJITO_TIMEZONE and the hub's MOJITO_TIMEZONE
# (compiled into the menu-bar time label)
MOJITO_TIMEZONE=America/Los_Angeles

# ---- only for npm run release ----
# folder outside the repo holding cards.env (hub URL + source:cards token) for the "Mac app updated" push
MOJITO_SECRETS_DIR=/path/outside/the/repo/secrets
# folder outside the repo holding the self-signed code-signing keychain (mojito-codesign.keychain-db)
# and its password file codesign.pass; see README "签名"
MOJITO_CODESIGN_DIR=/path/outside/the/repo/codesign
# common name of that certificate
MOJITO_CODESIGN_IDENTITY=mojito self-signed
