# The maintainer session's access to the hub (docs/self-rebuild-loop.md).
# Copy to ~/.config/mojito/secrets/maintainer.env (mode 600). Never paste the token into a prompt.

# The hub's HTTPS address
MOJITO_HUB_URL=https://hub.example.com
# The `maintainer` token from the hub's token file
MOJITO_MAINTAINER_TOKEN=
