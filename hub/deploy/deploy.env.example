# Settings for the scripts you run from your own computer (deploy.sh, deploy-web.sh,
# install-secrets.sh, mac-env.sh, mac/install.sh, sources/cards). Keep a filled-in copy OUTSIDE the
# repo, e.g. ~/.config/mojito/deploy.env, and load it before running a script:
#   set -a; . ~/.config/mojito/deploy.env; set +a
# Every script stops with the variable's name when one it needs is missing.

# ssh alias of the server that runs hub + agent (an entry in ~/.ssh/config)
MOJITO_SSH_HOST=my-server

# public https address of the hub, no trailing slash (Tailscale serve/funnel, Cloudflare Tunnel, Caddy…)
MOJITO_HUB_URL=https://hub.example.com

# folder outside any repo holding the secret files:
#   claude-oauth-token, ical-url, google-client.json, google-oauth-calendar.json,
#   google-oauth-gmail.json, fcm-service-account.json, cards.env, maintainer.env
MOJITO_SECRETS_DIR=/path/outside/the/repo/secrets

# your IANA timezone; hub, agent, worker, app and Mac app must all use the same one
MOJITO_TIMEZONE=America/Los_Angeles

# shown on the hub's public pages (/ and /privacy): who runs the instance (one word, no spaces) and a
# contact address (also the Web Push VAPID subject). Both are public: use an alias.
MOJITO_OWNER_NAME=Sam
MOJITO_CONTACT_EMAIL=you@example.com
