[Unit]
Description=mojito hub (FastAPI + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
User=mojito
Group=mojito
WorkingDirectory=/opt/mojito/hub
EnvironmentFile=/var/lib/mojito/env
ExecStart=/usr/local/bin/uv run --frozen --no-sync uvicorn mojito_hub.main:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mojito
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
