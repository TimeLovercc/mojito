# The hub's environment on the server: /var/lib/mojito/env (root:root, 600), read by the
# mojito-hub systemd unit. setup-server.sh writes the first block, install-secrets.sh and
# gen-vapid.sh the rest. Every variable is required: the hub refuses to start without one.
# Values must not contain spaces (deploy.sh splits the file into arguments for its preflight).

MOJITO_DB=/var/lib/mojito/hub.db
MOJITO_TOKENS=/var/lib/mojito/tokens.json
# first-start data (docs/SETUP.md 3.4): setup-server.sh writes an empty one here; for a populated
# example use examples/demo/demo_data.py seed --day today ... (docs/seed.example.json has fixed dates)
MOJITO_SEED=/var/lib/mojito/seed.json
MOJITO_ATTACHMENTS_DIR=/var/lib/mojito/attachments

MOJITO_ICAL_URL=https://calendar.google.com/calendar/ical/<secret address>/basic.ics
MOJITO_FCM_CREDENTIALS=/var/lib/mojito/fcm.json
MOJITO_VAPID_KEY_FILE=/var/lib/mojito/vapid.pem
MOJITO_VAPID_SUBJECT=mailto:you@example.com
# shown on the public pages / and /privacy: who runs this instance (one word, no spaces) and how to reach them
MOJITO_OWNER_NAME=Sam
MOJITO_CONTACT_EMAIL=you@example.com
MOJITO_PUBLIC_URL=https://hub.example.com
MOJITO_WEB_DIR=/opt/mojito-web/current
# IANA timezone of the owner: day boundaries, morning/evening times and subscriptions use it
MOJITO_TIMEZONE=America/Los_Angeles

UV_PROJECT_ENVIRONMENT=/var/lib/mojito/venv
UV_PYTHON_INSTALL_DIR=/var/lib/mojito/python
UV_CACHE_DIR=/var/lib/mojito/uv-cache
