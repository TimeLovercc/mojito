# Copy to mobile/.env (ignored by git) and fill in. Expo CLI loads it for `npm run web`, prebuild and
# exports; scripts/build-apk.sh and scripts/update.mjs load it too. Missing values fail.
# `npm run mock` (the mock server) reads EXPO_PUBLIC_MOJITO_TIMEZONE from here too.

# your IANA timezone, the same as the hub's MOJITO_TIMEZONE (compiled into the JS bundle)
EXPO_PUBLIC_MOJITO_TIMEZONE=America/Los_Angeles

# over-the-air updates: `none`, or `eas` with your own EAS project (run `npx eas-cli init` to get one)
MOJITO_OTA=none
# MOJITO_EAS_OWNER=<your expo account>
# MOJITO_EAS_PROJECT_ID=<uuid from eas init>

# ---- only for release APKs (scripts/build-apk.sh) ----
# Firebase config of an Android app whose package name equals android.package in app.json
MOJITO_GOOGLE_SERVICES_JSON=/path/outside/the/repo/google-services.json
# storeFile, storePassword, keyAlias, keyPassword of your release keystore
MOJITO_SIGNING_PROPERTIES=/path/outside/the/repo/signing.properties
# where built APKs and their runtime fingerprints are kept (outside the repo)
MOJITO_APK_DIR=/path/outside/the/repo/apk
# folder holding cards.env (hub URL + source:cards token) for the "new build" push
MOJITO_SECRETS_DIR=/path/outside/the/repo/secrets
