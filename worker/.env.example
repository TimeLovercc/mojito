# Mojito worker. Copy to worker/.env (mode 600); variables already in the environment win.
# Every variable is required: the worker exits naming any that are missing.

# The hub's HTTPS address
MOJITO_HUB_URL=https://hub.example.com
# The `worker` token from the hub's token file
MOJITO_WORKER_TOKEN=
# Absolute path of the claude executable (`command -v claude`); the worker uses your own Claude Code login
MOJITO_CLAUDE_BIN=
# Same IANA timezone as the hub
MOJITO_TIMEZONE=America/Los_Angeles
# Folder containing the git repositories the worker may read (read-only, tracked files only)
MOJITO_PROJECTS_ROOT=~/src
# Gmail read-only grant (hub/deploy/google-auth.py --scope gmail); it never leaves this machine.
# The file may be absent: mail features then show as not connected.
MOJITO_GMAIL_OAUTH_FILE=~/.config/mojito/secrets/google-oauth-gmail.json
# Zotero library for the paper feed's taste signals: path to zotero.sqlite, or none
MOJITO_ZOTERO_DB=none
# arXiv categories for the daily paper feed, comma-separated
MOJITO_ARXIV_CATEGORIES=cs.AI,cs.HC
